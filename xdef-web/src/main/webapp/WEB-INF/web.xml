<?xml version="1.0" encoding="UTF-8"?>
<web-app
	version="6.1"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
   	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
>
    <context-param>
        <param-name>contextDefaultEncoding</param-name>
        <param-value>UTF-8</param-value>
    </context-param>

    <filter>
        <!-- redirects the default "/" landing page to a localized "lang/" one, before anything else runs -->
        <filter-name>LangRedirectFilter</filter-name>
        <filter-class>org.xdef.web.filter.LangRedirectFilter</filter-class>
    </filter>
    <filter>
        <!-- bakes the shared header/footer into html-pages server-side, avoiding a visible pop-in -->
        <filter-name>HeaderFooterFilter</filter-name>
        <filter-class>org.xdef.web.filter.HeaderFooterFilter</filter-class>
    </filter>

    <servlet>
        <servlet-name>Playground</servlet-name>
        <servlet-class>org.xdef.web.servlet.Playground</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GenXdef</servlet-name>
        <servlet-class>org.xdef.web.servlet.GenXdef</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GenSchema</servlet-name>
        <servlet-class>org.xdef.web.servlet.GenSchema</servlet-class>
    </servlet>
    <servlet>
        <!-- candidate to remove, temporary service to download, upload files -->
        <servlet-name>Service</servlet-name>
        <servlet-class>org.xdef.web.servlet.Service</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LatestVersion</servlet-name>
        <servlet-class>org.xdef.web.servlet.LatestVersion</servlet-class>
    </servlet>

    <filter-mapping>
        <!-- mapped before HeaderFooterFilter: on redirect, that filter must not run at all -->
        <filter-name>LangRedirectFilter</filter-name>
        <url-pattern>/index.html</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <!-- maps to *.html and servlets - all contains headers+footers -->
        <filter-name>HeaderFooterFilter</filter-name>
        <url-pattern>*.html</url-pattern>
        <servlet-name>Playground</servlet-name>
        <servlet-name>GenXdef</servlet-name>
        <servlet-name>GenSchema</servlet-name>
    </filter-mapping>

    <servlet-mapping>
        <servlet-name>Playground</servlet-name>
        <url-pattern>/playground/Playground</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GenXdef</servlet-name>
        <url-pattern>/playground/GenXdef</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GenSchema</servlet-name>
        <url-pattern>/playground/GenSchema</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <!-- candidate to remove, see servlet Service -->
        <servlet-name>Service</servlet-name>
        <url-pattern>/Service</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LatestVersion</servlet-name>
        <url-pattern>/LatestVersion</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>