<xd:collection
        xmlns:xd     ="http://www.xdef.org/xdef/4.2"
        xmlns:jx="http://www.xdef.org/json/nodes/4.2"
>
    <xd:def xmlns:xd     ="http://www.xdef.org/xdef/4.2"
            impl-version ="2026/06.01" impl-date="2026-06-01"
            xd:root      ="SynPLscript"
            name         ="SynPLscript"
    >
        <xd:declaration scope = 'global'>
            type  functionName    jstring(1,30);
            type  code            jstring(1,9999);
            type  params          jstring(1,9999);
            type  async           enum('Y','N');
            type  changeLog       enum('Y','N');
            type  sla             enum('Y','N');
            type  isAllowed       enum('Y','N');
            type  desc            jstring(1,1000);
            type  eventName       jstring(1,30);
            type  functionDesc    jstring(1,9999);
            type  scriptVersion   xdatetime('yyyy-MM-dd');
            type  interval        regex('^[0-9]{1,3}[S|M|H|D]$');
            type  statusName      jstring(1,100);
            type  sysValue        jstring(1,100);
            type  userRole        jstring(1,30);
            type  valueType       enum('STRING', 'INTEGER', 'DECIMAL', 'DATE', 'DATETIME', 'INTERVAL');
            type  variableName    jstring(1,30);
            type  variableRef     jstring(1,255);
            type  wfScriptName    jstring(1,30);
            type  subjectRoleCode enum('IN','SD','SC');

            uniqueSet variableSet      { variableName:  variableName() };   /* duplicita proměnných          */
            uniqueSet paramSet         { paramName:     variableName() };   /* duplicita parametru v eventu  */
            uniqueSet statusSet        { statusName:    statusName()   };   /* duplicita stavů               */
            uniqueSet eventStatusSet   { statusName:    statusName(); eventName:        eventName()};      /* duplicita eventů ve stavu     */
        </xd:declaration>

        <xd:json name = "SynPLscript">
            {
                "SynPLscript" : {
                    "Name":             "  wfScriptName()",
                    "SubjectRoleCode" : "  subjectRoleCode()",
                    "Version":          "  scriptVersion()",
                    "Desc":             "? desc()",
                    "Note":             "? desc()",
                    "SysValues":        [ { "%script" :  "occurs 0..*; ref SysValue#SysValue"         } ],
                    "Variables":        [ { "%script" :  "occurs 0..*; ref Variable#Variable"         } ],
                    "UserRoles":        [ { "%script" :  "occurs 0..*; ref UserRole#UserRole"         } ],
                    "UsedFunctions":    [ { "%script" :  "occurs 0..*; ref UsedFunction#UsedFunction" } ],
                    "Statuses":         [ { "%script" :  "occurs 1..*; ref Status#Status"             } ],
                    "EndStatuses":      [ { "%script" :  "occurs 1..*; ref EndStatus#EndStatus"       } ]
                }
            }
        </xd:json>

        <xd:component>
            %class cz.syntea.synpl.server.model.xdef.workflow.XCSynPLscript  %link  SynPLscript#SynPLscript;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCSysValue     %link  SysValue#SysValue;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCVariable     %link  Variable#Variable;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCUserRole     %link  UserRole#UserRole;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCUsedFunction %link  UsedFunction#UsedFunction;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCStatus       %link  Status#Status;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCEvent        %link  Event#Event;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCEndStatus    %link  EndStatus#EndStatus;
            %class cz.syntea.synpl.server.model.xdef.workflow.XCActionCode   %link  ActionCode#ActionCode;

            %bind SynPLscript %link SynPLscript#SynPLscript/jx:map/jx:map;

            %bind Name    %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:item[1];
            %bind Version %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:item[2];
            %bind Desc    %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:item[3];
            %bind Note    %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:item[4];

            %bind SysValues     %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[1];
            %bind SysValue      %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[1]/jx:map;

            %bind Variables     %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[2];
            %bind Variable      %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[2]/jx:map;

            %bind UserRoles     %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[3];
            %bind UserRole      %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[3]/jx:map;

            %bind UsedFunctions %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[4];
            %bind UsedFunction  %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[4]/jx:map;

            %bind Statuses      %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[5];
            %bind Status        %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[5]/jx:map;

            %bind EndStatuses   %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[6];
            %bind EndStatus     %link SynPLscript#SynPLscript/jx:map/jx:map/$mixed/jx:array[6]/jx:map;
        </xd:component>
    </xd:def>

    <xd:def name = 'SysValue'>
        <xd:json name='SysValue'>
            {
                "SysValue": "  variableSet.variableName.ID()",
                "Type":     "  valueType()",
                "Value":    "  sysValue()",
                "Desc":     "? desc()"
            }
        </xd:json>
        <xd:component>
            %bind SysValue  %link SysValue#SysValue/jx:map/$mixed/jx:item[1];
            %bind Type      %link SysValue#SysValue/jx:map/$mixed/jx:item[2];
            %bind Value     %link SysValue#SysValue/jx:map/$mixed/jx:item[3];
            %bind Desc      %link SysValue#SysValue/jx:map/$mixed/jx:item[4];
        </xd:component>
    </xd:def>

    <xd:def name = 'Variable'>
        <xd:json name='Variable'>
            {
                "Variable": "  variableSet.variableName.ID()",
                "Type":     "  valueType()",
                "Ref":      "? variableRef()",
                "Value":    "? sysValue()",
                "Desc":     "? desc()"
            }
        </xd:json>
        <xd:component>
            %bind Variable      %link Variable#Variable/jx:map/$mixed/jx:item[1];
            %bind Type          %link Variable#Variable/jx:map/$mixed/jx:item[2];
            %bind Ref           %link Variable#Variable/jx:map/$mixed/jx:item[3];
            %bind Value         %link Variable#Variable/jx:map/$mixed/jx:item[4];
            %bind Desc          %link Variable#Variable/jx:map/$mixed/jx:item[5];
        </xd:component>
    </xd:def>

    <xd:def name = 'UserRole'>
        <xd:json name='UserRole'>
            {
                "UserRole": "  userRole()",
                "Desc":     "? desc()"
            }
        </xd:json>
        <xd:component>
            %bind UserRole      %link UserRole#UserRole/jx:map/$mixed/jx:item[1];
            %bind Desc          %link UserRole#UserRole/jx:map/$mixed/jx:item[2];
        </xd:component>
    </xd:def>

    <xd:def name = 'UsedFunction'>
        <xd:json name='UsedFunction'>
            {
                "Name": "   functionName()",
                "Desc": "?  functionDesc()",
                "Version": "? scriptVersion()",
                "Params":  "? code()"
            }
        </xd:json>
        <xd:component>
            %bind Name        %link UsedFunction#UsedFunction/jx:map/$mixed/jx:item[1];
            %bind Desc        %link UsedFunction#UsedFunction/jx:map/$mixed/jx:item[2];
            %bind Version     %link UsedFunction#UsedFunction/jx:map/$mixed/jx:item[3];
            %bind Params      %link UsedFunction#UsedFunction/jx:map/$mixed/jx:item[4];
        </xd:component>
    </xd:def>

    <xd:def name = 'Status'>
        <xd:json name = 'Status'>
            {
                "Status":       "  statusSet.statusName.ID()",
                "ActionCode":   { "%script": "0..1; ref ActionCode#ActionCode;" },
                "TimeOverStep": "? interval()",
                "IsSlaRunning":     "  sla()",
                "IsSlaEnding":      "  sla()",
                "IsSlaSettlement":  "  sla()",
                "IsSlaWorkStart":   "? sla()",
                "IsSlaFirstAction": "? sla()",
                "ChangeLog":    "? changeLog()",
                "Events":       [ { "%script": "1..*; ref Event#Event;" } ]
            }
        </xd:json>
        <xd:component>
            %bind Status       %link Status#Status/jx:map/$mixed/jx:item[1];
            %bind ActionCode   %link Status#Status/jx:map/$mixed/jx:map[1];
            %bind TimeOverStep %link Status#Status/jx:map/$mixed/jx:item[2];
            %bind ChangeLog    %link Status#Status/jx:map/$mixed/jx:item[3];
            %bind Events       %link Status#Status/jx:map/$mixed/jx:array[1];
            %bind Event        %link Status#Status/jx:map/$mixed/jx:array[1]/jx:map;
        </xd:component>
    </xd:def>

    <xd:def name = 'Event'>
        <xd:json name = 'Event'>
            {
                "Event":                 " eventName()",
                "UserRoleAny":           ["occurs 1..* userRole()"],
                "ActionCode":            { "%script": "0..1; ref ActionCode#ActionCode;" },
                "NextStatus":            "? statusName()",
                "Desc":                  "? desc()",
                "IsAssigneeAllowed":     "? isAllowed()",
                "IsWatcherAllowed":      "? isAllowed()",
                "IsCollaboratorAllowed": "? isAllowed()"
            }
        </xd:json>
        <xd:component>
            %bind Event                 %link Event#Event/jx:map/$mixed/jx:item[1];
            %bind UserRoleAny           %link Event#Event/jx:map/$mixed/jx:array[1];
            %bind ActionCode            %link Event#Event/jx:map/$mixed/jx:map[1];
            %bind NextStatus            %link Event#Event/jx:map/$mixed/jx:item[2];
            %bind Desc                  %link Event#Event/jx:map/$mixed/jx:item[3];
            %bind IsAssigneeAllowed     %link Event#Event/jx:map/$mixed/jx:item[4];
            %bind IsWatcherAllowed      %link Event#Event/jx:map/$mixed/jx:item[5];
            %bind isCollaboratorAllowed %link Event#Event/jx:map/$mixed/jx:item[6];
        </xd:component>
    </xd:def>

    <xd:def name = 'ActionCode'>
        <xd:json name = 'ActionCode'>
            {
                "Async": "? async()",
                "Code":  "? code()"
            }
        </xd:json>
    </xd:def>

    <xd:def name = 'EndStatus'>
        <xd:json name = 'EndStatus'>
            {
                "EndStatus":  " statusSet.statusName.ID()",
                "ActionCode": { "%script": "0..1; ref ActionCode#ActionCode;" },
                "ChangeLog":  "? changeLog()"
            }
        </xd:json>
        <xd:component>
            %bind EndStatus       %link EndStatus#EndStatus/jx:map/$mixed/jx:item[1];
            %bind ActionCode      %link EndStatus#EndStatus/jx:map/$mixed/jx:map[1];
            %bind ChangeLog       %link EndStatus#EndStatus/jx:map/$mixed/jx:item[2];
        </xd:component>
    </xd:def>

</xd:collection>