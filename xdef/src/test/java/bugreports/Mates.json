{ "SynPLscript": { "Name": "SD-Test_Scenario",
    "SubjectRoleCode": "SD",
    "Version": "2026-06-01",
    "Desc": "Testovaci WF Script SD",
    "SysValues": [{"SysValue": "SynPL", "Type": "STRING", "Value": "SynPL version 0.2"}],
    "Variables": [
      { "Variable": "TaskID",
        "Type": "STRING",
        "Ref": "Task@TaskID",
        "Desc": "Identifikator ukolu"
      },
      { "Variable": "TaskName",
        "Type": "STRING",
        "Ref": "Task@TaskName",
        "Desc": "Nazev ukolu"
      },
      { "Variable": "TaskTypeIN",
        "Type": "STRING",
        "Value": "testTaskType",
        "Desc": "Id typu ukolu"
      },
      { "Variable": "ProjectName",
        "Type": "STRING",
        "Ref": "Project@ProjectName",
        "Desc": "Nazev projektu"
      },
      { "Variable": "SubjectRoleCode",
        "Type": "STRING",
        "Value": "SD",
        "Desc": "Kod role subjektu (IN, SD, SC)"
      },
      { "Variable": "RoleName_PM",
        "Type": "STRING",
        "Value": "Projektovy manazer",
        "Desc": "Nazev role projektoveho manazera"
      },
      { "Variable": "StatusName_Opened",
        "Type": "STRING",
        "Value": "Opened",
        "Desc": "Nazev stavu Opened"
      }
    ],
    "UserRoles": [
      {"UserRole": "#WF", "Desc": "Automaticky WF skript"},
      {"UserRole": "PM", "Desc": "Projektovy vedouci poskytovatele"},
      {"UserRole": "REP", "Desc": "Zakaznik, ktery task nahlasil"}
    ],
    "UsedFunctions": [
      { "Name": "cloneTask",
        "Desc": "Naklonovani tasku ze SD do IN",
        "Params": "newTaskType    - Nazev typu tasku pro interni klon\ncopyWfStatus   - Zda kopirovat stav\ncopyDoc        - Zda kopirovat dokumenty\n"
      },
      { "Name": "setDefaultTaskAssignee",
        "Desc": "Zmena vlastnika tasku na vychoziho uzivatele pro danou roli",
        "Params": "TaskID          - Identifikator ukolu\nProjectName     - Nazev projektu\nUserRoleName    - Nazev uzivatelske role\nsubjectRoleCode - Kod role subjektu (IN, SD, SC)\n"
      }
    ],
    "Statuses": [
      { "Status": "INIT",
        "IsSlaRunning": "N",
        "IsSlaEnding": "N",
        "IsSlaSettlement": "N",
        "Events": [
          { "Event": "Open",
            "UserRoleAny": ["#WF", "PM"],
            "IsAssigneeAllowed": "Y",
            "ActionCode": { "Async": "Y",
              "Code": "def copyWfStatus = false\ndef copyDoc = true\ncloneTask(TaskID, TaskName, TaskTypeIN, copyWfStatus, copyDoc)\nif (TaskName == null) {\n   setDefaultTaskAssignee(TaskID, ProjectName, RoleName_PM, SubjectRoleCode)\n}\n"
            },
            "NextStatus": "In Progress"
          }
        ]
      },
      { "Status": "In Progress",
        "ActionCode": { "Async": "N",
          "Code": "setDefaultTaskAssignee(TaskID, ProjectName, RoleName_PM, SubjectRoleCode)\n"
        },
        "IsSlaRunning": "Y",
        "IsSlaEnding": "N",
        "IsSlaSettlement": "N",
        "ChangeLog": "Y",
        "Events": [
          { "Event": "Ask customer",
            "UserRoleAny": ["#WF", "PM"],
            "NextStatus": "Solved"
          }
        ]
      },
      { "Status": "Solved",
        "IsSlaRunning": "N",
        "IsSlaEnding": "Y",
        "IsSlaSettlement": "Y",
        "Events": [
          { "Event": "Accept",
            "UserRoleAny": ["#WF", "REP"],
            "ActionCode": { "Async": "Y",
              "Code": "def note = \"Zakaznik \\\"potvrdil\\\" reseni\"\nprintln(note)\n"
            },
            "NextStatus": "Closed"
          }
        ]
      }
    ],
    "EndStatuses": [{"EndStatus": "Closed", "ChangeLog": "Y"}]
  }
}